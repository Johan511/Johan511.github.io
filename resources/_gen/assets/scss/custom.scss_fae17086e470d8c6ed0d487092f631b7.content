html {
  scroll-behavior: smooth;
  scroll-snap-type: y mandatory; }

.navigation {
  display: none; }

.content {
  flex-direction: column; }

.centered.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  scroll-snap-align: start; }

section[id] {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  scroll-snap-align: start;
  padding: 6rem 0;
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.6s ease, transform 0.6s ease; }

section[id].visible {
  opacity: 1;
  transform: translateY(0); }

section[id]:last-of-type {
  padding-bottom: 8rem; }

section[id] > article > header,
section[id] > header {
  margin-top: 0 !important;
  margin-bottom: 2.4rem !important; }

section[id] > article > header h1,
section[id] > header h1 {
  font-size: 3.2rem; }

@media only screen and (max-width: 768px) {
  section[id] {
    padding: 5rem 2rem; } }

.code-comparison {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.6rem;
  margin: 2rem 0; }
  .code-comparison .code-pane {
    display: flex;
    flex-direction: column;
    min-width: 0; }
  .code-comparison .code-label {
    font-weight: 600;
    font-size: 1.4rem;
    margin-bottom: 0.6rem;
    color: var(--font-color, #222); }
  .code-comparison pre {
    margin: 0;
    flex: 1;
    overflow-x: auto;
    font-size: 1.3rem; }
  @media only screen and (max-width: 768px) {
    .code-comparison {
      grid-template-columns: 1fr; } }

/*# sourceMappingURL=custom.css.map */