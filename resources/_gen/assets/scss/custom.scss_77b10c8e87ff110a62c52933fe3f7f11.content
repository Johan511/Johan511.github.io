html{scroll-behavior:smooth;scroll-snap-type:y mandatory}.navigation{display:none}.content{flex-direction:column}.centered.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;scroll-snap-align:start}section[id]{min-height:100vh;display:flex;flex-direction:column;justify-content:center;scroll-snap-align:start;padding:6rem 0;opacity:0;transform:translateY(40px);transition:opacity .6s ease,transform .6s ease}section[id].visible{opacity:1;transform:translateY(0)}section[id]:last-of-type{padding-bottom:8rem}section[id]>article>header,section[id]>header{margin-top:0!important;margin-bottom:2.4rem!important}section[id]>article>header h1,section[id]>header h1{font-size:3.2rem}@media only screen and (max-width:768px){section[id]{padding:5rem 2rem}}