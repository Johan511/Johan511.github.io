html{scroll-behavior:smooth;scroll-snap-type:y mandatory}.content{flex-direction:column}.centered.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;scroll-snap-align:start}section[id]{min-height:100vh;display:flex;flex-direction:column;justify-content:center;scroll-snap-align:start;padding:8rem 0}section[id]:last-of-type{padding-bottom:12rem}section[id=posts]{background:rgba(128,128,128,4%)}section[id=contact]{background:rgba(128,128,128,4%)}section[id]>article>header,section[id]>header{margin-top:0!important;margin-bottom:2.4rem!important}section[id]>article>header h1,section[id]>header h1{font-size:3.2rem}